<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>umiusi_autonomy</name>
  <version>0.0.0</version>
  <description>
    Deploy-side ROS 2 nodes for UMIUSI autonomous balloon popping. perception_node runs the learned
    balloon detector on the onboard camera and publishes typed detections; navigator_node runs the
    shared behaviour FSM and drives the sinsei_umiusi_control thrusters over the direct-override
    topics. Both are THIN rclpy wrappers around the ROS-free umiusi_perception Python package, so the same
    perception + autonomy code runs in simulation (tools/autonomy_run) and on the robot.
  </description>
  <maintainer email="satoimo3taro183@gmail.com">satoi</maintainer>
  <license>MIT</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>          <!-- camera_bridge_node -->
  <exec_depend>python3-opencv</exec_depend>     <!-- camera_bridge_node -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>umiusi_autonomy_msgs</exec_depend>
  <exec_depend>sinsei_umiusi_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>   <!-- 同梱検出器のパス解決 -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>      <!-- umiusi_perception の FSM 連鎖が使う -->
  <!-- 共有部品 (arm/disarm と IMU サニティ)。**制御層 (umiusi_rl_control) には依存しない** —
       以前は共有物が制御層の中にあり、上位のこちらが下位へ import しに行っていた (依存が逆) -->
  <exec_depend>umiusi_common</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
