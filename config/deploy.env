# 実機運用時の環境変数。tools/umiusi_stack.sh がこれを読む。
#   source config/deploy.env

export UMIUSI_WS="$HOME/ros2-ws"
export UMIUSI_MODEL="$HOME/models/camp_mix.pt"
export UMIUSI_PERCEPTION_SRC="$HOME/perception/src"

# 実機用カメラ設定 (デバイス番号は必ず現物で確認すること)
export UMIUSI_CAMERAS_PARAM="$(ros2 pkg prefix umiusi_autonomy 2>/dev/null)/share/umiusi_autonomy/config/cameras_deploy.yaml"

# perception が読む RTSP。前方カメラ = cam1
export UMIUSI_RTSP_URL="rtsp://localhost:8554/cam1"

# torch のスレッド数。実機では 1 が最速 (他ノードとの奪い合いで
# スレッドを増やすほど遅くなる: 負荷下で 4 スレッド 142ms/frame vs 1 スレッド 114ms/frame)
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

export UMIUSI_LOGDIR="$HOME/umiusi_logs"
